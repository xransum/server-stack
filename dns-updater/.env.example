# DreamHost API token
# Generate one at: https://panel.dreamhost.com/?tree=home.api
DREAMHOST_API_TOKEN=

# Discord webhook credentials
# Create a webhook under Server Settings -> Integrations -> Webhooks
# Webhook URL format: https://discord.com/api/webhooks/<ID>/<TOKEN>
DISCORD_WEBHOOK_ID=
DISCORD_WEBHOOK_TOKEN=

# Comma-separated list of DNS records to keep up to date
# Format: <record>:<type>
# Example: home.example.com:A,home.example.com:AAAA
TARGET_RECORDS=
