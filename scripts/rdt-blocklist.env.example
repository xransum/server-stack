# rdt-blocklist environment file.
# Copy to /etc/rdt-blocklist.env on the server and fill in API keys.
# See docs/rdt-blocklist.md for full install instructions.

# Path to the rdt-client SQLite database on the server.
RDT_DB_PATH=/mnt/raid0/media/Downloads/rdtclient.db

SONARR_URL=http://localhost:8989
SONARR_API_KEY=

RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Log matches but do not blocklist or delete. Set to false when verified.
DRY_RUN=true

# How often to poll the RDT database (seconds). Default: 120.
# POLL_INTERVAL_SECONDS=120

# --- Mode A: RDT provider errors --------------------------------------------
# Comma-separated substrings matched case-insensitively against the Error
# column. Defaults cover the known RDT provider failure messages.
# ERROR_PATTERNS=infringing file,could not add to provider,a task was canceled

# --- Mode B: stuck in processing state --------------------------------------
# RdStatusRaw values (comma-separated) that indicate a torrent is stuck in
# a processing limbo on Real-Debrid's side. These states should resolve in
# seconds to minutes; anything older than STUCK_PROCESSING_MINUTES is treated
# as permanently stuck and blocklisted + re-searched.
# STUCK_PROCESSING_STATUSES=magnet_conversion,waiting_files_selection,queued,compressing,uploading

# Minutes a torrent must be in a stuck status before action is taken.
# magnet_conversion should resolve in seconds; 5 minutes is generous.
# Default: 120 -- recommend overriding to 5.
STUCK_PROCESSING_MINUTES=5

