# rdt-blocklist environment file.
# Copy to /etc/rdt-blocklist.env on the server and fill in API keys.
# See docs/rdt-blocklist.md for full install instructions.

# Path to the rdt-client SQLite database on the server.
RDT_DB_PATH=/mnt/raid0/media/Downloads/rdtclient.db

SONARR_URL=http://localhost:8989
SONARR_API_KEY=

RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Log matches but do not blocklist or delete. Set to false when verified.
DRY_RUN=true

# How often to poll the RDT database (seconds). Default: 120.
# POLL_INTERVAL_SECONDS=120

# Comma-separated substrings matched case-insensitively against the Error
# column. Defaults cover the known RDT provider failure messages.
# ERROR_PATTERNS=infringing file,could not add to provider,a task was canceled
