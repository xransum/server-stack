# byparr-proxy per-instance config.
# Install as /etc/byparr-proxy/<instance>.env (e.g. /etc/byparr-proxy/1337x.env),
# then `sudo systemctl enable --now byparr-proxy@<instance>`.

# Upstream indexer base URL. No trailing slash.
UPSTREAM=https://1337x.to

# Byparr /v1 endpoint. Local Byparr from this stack is on 8192.
# We deliberately target Byparr directly, NOT the byparr-unwrap sidecar on
# 8193: the unwrap sidecar only matters for non-HTML responses (JSON, RSS,
# PDF) and indexer pages this proxy fetches are HTML, so the extra hop
# would be wasted.
BYPARR=http://127.0.0.1:8192/v1

# Per-request timeout passed to Byparr. Cloudflare solves can be slow under
# load; bump this if you see "byparr request failed: timed out" in journald.
TIMEOUT_MS=120000

# Local listen port. Pick a unique port per instance.
#   8881 -> 1337x
#   8882 -> next indexer, etc.
PORT=8881

LOG_LEVEL=INFO

# In-memory cache TTL for successful responses (seconds). Empty result
# pages are not cached. Restart clears the cache. Set to 0 to disable.
CACHE_TTL_S=3600

# Short-circuit /cat/... paths (indexer health-test endpoints) with a
# synthetic results page so health checks do not trigger real Byparr
# solves. Real searches go to /search/... and are unaffected. Disable
# only if you actually want Prowlarr to browse categories through Byparr.
STUB_CAT_PATHS=true
