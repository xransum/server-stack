# queue-cleaner environment file.
# Copy to /etc/queue-cleaner.env, fill in the API keys, then:
#   sudo chmod 600 /etc/queue-cleaner.env
#   sudo chown root:root /etc/queue-cleaner.env

# --- Sonarr -----------------------------------------------------------------
# Leave both blank to skip Sonarr.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# --- Radarr -----------------------------------------------------------------
# Leave both blank to skip Radarr.
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# --- Behavior ---------------------------------------------------------------

# If true, log matches but do not delete anything. Start with true, verify
# the logged matches look correct, then flip to false.
DRY_RUN=true

# If true, blocklist the release on delete so it is not immediately re-grabbed
# from the same indexer. Requires the Prowlarr "Sync Reject Blocklisted
# Torrent Hashes While Grabbing" setting on both Sonarr and Radarr app entries
# for the blocklist to be honored across indexers. See docs/decluttarr.md.
BLOCKLIST=true

# Minimum age (in minutes) since the queue item was `added` before we are
# willing to delete it. Acts as a guard against deleting an item that is
# briefly hiccupping. 15 is a reasonable default; raise it if you see false
# positives, lower it if you want faster cleanup.
MIN_AGE_MINUTES=15

# Comma-separated list of substrings (case-insensitive) to match against
# the queue item's errorMessage. An item matches if ANY substring is found.
# Defaults if unset:
#   "qBittorrent is reporting an error,The download is stalled with no connections"
# Override here if you encounter additional rdt-client failure messages.
#ERROR_PATTERNS=qBittorrent is reporting an error,The download is stalled with no connections
