# queue-cleaner environment file.
# Copy to /etc/queue-cleaner.env, fill in the API keys, then:
#   sudo chmod 600 /etc/queue-cleaner.env
#   sudo chown root:root /etc/queue-cleaner.env

# --- Sonarr -----------------------------------------------------------------
# Leave both blank to skip Sonarr.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# --- Radarr -----------------------------------------------------------------
# Leave both blank to skip Radarr.
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# --- Behavior ---------------------------------------------------------------

# If true, log matches but do not delete anything. Start with true, verify
# the logged matches look correct, then flip to false.
DRY_RUN=true

# If true, blocklist the release on delete (Mode 1 and Mode 2 only) so it is
# not immediately re-grabbed from the same indexer. Requires the Prowlarr
# "Sync Reject Blocklisted Torrent Hashes While Grabbing" setting on both
# Sonarr and Radarr app entries. See docs/queue-cleaner.md.
BLOCKLIST=true

# Minimum age (in minutes) since the queue item was `added` before acting on
# it. Guards against touching items that are briefly hiccupping.
MIN_AGE_MINUTES=15

# --- Mode 1: rdt-client zero-size stall (ERROR_PATTERNS) --------------------
# Comma-separated substrings (case-insensitive) matched against errorMessage.
# Item must also have size==0 AND sizeleft==0 (zero-progress signature).
# Action: DELETE + blocklist + redownload (triggers fresh search).
# Defaults cover the known rdt-client failure messages; add more if needed.
#ERROR_PATTERNS=qBittorrent is reporting an error,The download is stalled with no connections

# --- Mode 2: import failure safety net (IMPORT_FAIL_PATTERNS) ---------------
# Matched against errorMessage with NO size==0 requirement (import failures
# have real file size). Fires when Sonarr's built-in Failed Download Handling
# loops or stalls on a genuinely unimportable release.
# Action: DELETE + blocklist + redownload (triggers fresh search).
# Set to empty string to disable: IMPORT_FAIL_PATTERNS=
#IMPORT_FAIL_PATTERNS=One or more episodes expected in this release were not imported,Failed to import episode

# --- Mode 3: force upgrade (FORCE_UPGRADE / FORCE_UPGRADE_PATTERNS) ---------
# When Sonarr/Radarr reject a completed download as "not an upgrade", this
# mode forces the import via the ManualImport command (bypasses quality profile
# checks), then clears the queue entry without blocklisting or re-searching.
# Useful when a season pack contains episodes already imported individually at
# a higher quality that no longer plays correctly.
# WARNING: the existing file on disk is replaced by the new download.
FORCE_UPGRADE=true
#FORCE_UPGRADE_PATTERNS=Not an upgrade for existing episode file(s),Not an upgrade for existing movie file(s)
