# queue-cleaner environment file.
# Copy to /etc/queue-cleaner.env, fill in the API keys, then:
#   sudo chmod 600 /etc/queue-cleaner.env
#   sudo chown root:root /etc/queue-cleaner.env

# --- Sonarr -----------------------------------------------------------------
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# --- Radarr -----------------------------------------------------------------
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# --- Behavior ---------------------------------------------------------------

# If true, log matches but do not delete anything. Start with true, verify
# the logged matches look correct, then flip to false.
DRY_RUN=true

# If true, blocklist the release on delete (Modes 1 and 2) so it is not
# immediately re-grabbed. Requires Prowlarr "Sync Reject Blocklisted Torrent
# Hashes While Grabbing" on both Sonarr and Radarr app entries.
BLOCKLIST=true

# Minimum age (in minutes) since the queue item was added before acting.
# Guards against touching items that are briefly hiccupping.
MIN_AGE_MINUTES=15

# --- Mode 1: rdt-client zero-size stall (ERROR_PATTERNS) --------------------
# Comma-separated substrings matched against errorMessage.
# Item must also have size==0 AND sizeleft==0.
# Action: blocklist + redownload.
#ERROR_PATTERNS=qBittorrent is reporting an error

# --- Mode 2: import failure / stalled (IMPORT_FAIL_PATTERNS) ----------------
# Matched against statusMessages (importBlocked) or errorMessage (warning).
# No size==0 requirement. Covers import failures AND stalled downloads.
# Action: blocklist + redownload.
#IMPORT_FAIL_PATTERNS=One or more episodes expected in this release were not imported,Failed to import episode,The download is stalled with no connections

# --- Mode 3: force upgrade (FORCE_UPGRADE) ----------------------------------
# When Sonarr/Radarr reject a completed download as "not an upgrade", force
# the import via ManualImport API (bypasses quality profile checks).
# WARNING: replaces the existing file on disk.
FORCE_UPGRADE=true
#FORCE_UPGRADE_PATTERNS=Not an upgrade for existing episode file(s),Not an upgrade for existing movie file(s)

# --- Mode 4: parse failure (PARSE_FAIL_PATTERNS) ----------------------------
# Sonarr could not parse the release to identify the episode. FDH already
# handles re-search; we blocklist and clear without triggering another search.
# Action: blocklist, no redownload trigger.
#PARSE_FAIL_PATTERNS=Unable to parse download, automatic import is not possible

# --- Mode 5: duplicate grab detection (DEDUP_GRABS) -------------------------
# Detects FDH grab storms: multiple releases downloading for the same episode.
# Keeps the highest-resolution grab (or any completed item), removes the rest.
# No blocklist -- releases are valid, just redundant.
DEDUP_GRABS=true
# Minimum number of grabs for the same episode before dedup acts.
DEDUP_MIN_GRABS=2
