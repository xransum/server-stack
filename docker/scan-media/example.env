# scan-media Docker environment file.
# RADARR_URL, RADARR_API_KEY, SONARR_URL, SONARR_API_KEY are shared across
# services and should be set in compose/.env, not here.
# Only service-specific secrets live in this file.

# Discord webhook URL for infection and scan-error notifications.
# Create at: Discord server → Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=
