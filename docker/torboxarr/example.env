# torboxarr Docker environment file — example/template.
# Copy to compose/torboxarr.env on media-vm and fill in real values.
# compose/torboxarr.env is gitignored -- never commit it.
#
# TorBoxarr impersonates a qBittorrent API locally and translates calls to
# TorBox's REST API. It downloads files to real local disk via HTTP range
# requests (no symlinks, no WebDAV -- correct for NFS).
#
# See: https://github.com/MrJoiny/TorBoxarr

# TorBox API token -- get from https://torbox.app/settings
TORBOXARR_TORBOX_API_TOKEN=get from torbox.app Settings

# Password for the fake qBittorrent login endpoint.
# Sonarr/Radarr must use this password when adding TorBoxarr as a download client.
# Pick any value -- it only authenticates within your LAN/Docker network.
TORBOXARR_QBIT_PASSWORD=changeme

# Root directory where completed downloads land.
# Categories map to subdirs: radarr -> <DATA_ROOT>/completed/radarr/
#                             sonarr -> <DATA_ROOT>/completed/sonarr/
TORBOXARR_DATA_ROOT=/mnt/media/downloads

# Run as same UID/GID as Sonarr/Radarr so NFS writes work correctly.
# Check with: id ransum  (should be 1000:1000 on media-vm)
PUID=1000
PGID=1000

# SABnzbd-compatible API key -- required by TorBoxarr even if you are not using
# the SABnzbd endpoint. Set to any non-empty value if only using qBittorrent mode.
TORBOXARR_SAB_API_KEY=changeme-sab
