# rdt-blocklist Docker environment file.
# Mirrors scripts/rdt-blocklist.env.example — keep in sync.
# Inside the Docker network, use container names not localhost.

# Path to the rdt-client database mounted into the container.
RDT_DB_PATH=/data/db/rdtclient.db

SONARR_URL=http://sonarr:8989
# SONARR_API_KEY — set in compose/.env as SONARR_API_KEY for shared rotation
SONARR_API_KEY=

RADARR_URL=http://radarr:7878
# RADARR_API_KEY — set in compose/.env as RADARR_API_KEY for shared rotation
RADARR_API_KEY=

# Log matches but do not blocklist or delete. Set to false when verified.
DRY_RUN=true

# POLL_INTERVAL_SECONDS=120

# Mode A: RDT provider errors
# ERROR_PATTERNS=infringing file,could not add to provider,a task was canceled

# Mode B: stuck in processing state
# STUCK_PROCESSING_STATUSES=magnet_conversion,waiting_files_selection,queued,compressing,uploading
# magnet_conversion resolves in seconds normally; 5 min is generous
STUCK_PROCESSING_MINUTES=5

