# queue-cleaner Docker environment file.
# Mirrors scripts/queue-cleaner.env.example -- keep in sync.
# Inside the Docker network use container names not localhost.

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

DRY_RUN=true
BLOCKLIST=true
MIN_AGE_MINUTES=15

# Mode 1: rdt-client zero-size stall -- size==0 required
# ERROR_PATTERNS=qBittorrent is reporting an error

# Mode 2: import failure / stalled -- no size check, blocklist + redownload
# IMPORT_FAIL_PATTERNS=One or more episodes expected in this release were not imported,Failed to import episode,The download is stalled with no connections

# Mode 3: force upgrade -- ManualImport bypass, no blocklist, no redownload
FORCE_UPGRADE=true
# FORCE_UPGRADE_PATTERNS=Not an upgrade for existing episode file(s),Not an upgrade for existing movie file(s)

# Mode 4: parse failure -- blocklist only, no redownload trigger
# PARSE_FAIL_PATTERNS=Unable to parse download, automatic import is not possible

# Mode 5: duplicate grab detection -- remove lower-quality dupes, no blocklist
DEDUP_GRABS=true
DEDUP_MIN_GRABS=2
