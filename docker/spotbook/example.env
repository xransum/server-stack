# spotbook environment variables — example / template
# Copy to compose/spotbook.env on media-vm and fill in real values.
# NEVER commit real values to git.

# Public HTTPS URL — must match exactly what you enter in Claude connector settings
SPOTBOOK_PUBLIC_BASE_URL=https://spotbook.xransum.com

# Google Maps API key — restricted to Places API (New) + Routes API in Cloud Console
# API key restriction: Places API (New), Routes API (no IP restriction — dynamic home IP)
GOOGLE_MAPS_API_KEY=<get from Google Cloud Console → Credentials>

# GitHub OAuth App credentials
# App settings: github.com/settings/developers → OAuth Apps → spotbook
# Callback URL must be: https://spotbook.xransum.com/github/callback
SPOTBOOK_GITHUB_CLIENT_ID=<get from GitHub OAuth App settings>
SPOTBOOK_GITHUB_CLIENT_SECRET=<get from GitHub OAuth App settings>

# Your numeric GitHub user ID (not username — IDs are stable, usernames can change)
# Find it: curl https://api.github.com/users/<your-login> | grep '"id"'
SPOTBOOK_GITHUB_ALLOWED_USER_ID=<your numeric GitHub user ID>

# SQLite database path — must be on a LOCAL volume, not NFS
SPOTBOOK_DB_PATH=/data/spotbook.db

# Backup directory — local by default; see docs/spotbook.md for NAS backup open item
SPOTBOOK_BACKUP_DIR=/data/backups

# ---------------------------------------------------------------------------
# Google API monthly caps — 80% of each free tier limit.
# Monthly counters reset on the 1st of the month in America/Los_Angeles
# (Google's billing timezone, confirmed 2026-11-24).
# Free tiers: Places Enterprise 1,000 | Places Pro 5,000 | Places Essentials 10,000
#             Routes Essentials 10,000 | Routes Pro 5,000 | Routes Enterprise 1,000
# ---------------------------------------------------------------------------

# Places API (New) caps
SPOTBOOK_ESSENTIALS_MONTHLY_CAP=8000
SPOTBOOK_PRO_MONTHLY_CAP=4000
SPOTBOOK_ENTERPRISE_MONTHLY_CAP=800

# Routes API (Compute Route Matrix) caps
# Note: we never use Pro or Enterprise routing features —
#       all travel_time calls are Essentials.
SPOTBOOK_ROUTES_ESSENTIALS_MONTHLY_CAP=8000
SPOTBOOK_ROUTES_PRO_MONTHLY_CAP=4000
SPOTBOOK_ROUTES_ENTERPRISE_MONTHLY_CAP=800

# Daily burst limit: fraction of monthly cap allowed per day (default 10%)
# Example: 8000 monthly cap × 0.1 = 800 elements per day maximum
SPOTBOOK_DAILY_CAP_FRACTION=0.1

# Optional: Discord webhook for operational alerts (cap warnings, backup failures,
# DCR registrations, unauthorized login attempts).
# Leave empty to disable. Use a dedicated webhook — do NOT reuse the scan-media webhook.
SPOTBOOK_DISCORD_WEBHOOK=
