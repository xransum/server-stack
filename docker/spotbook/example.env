# spotbook environment variables — example / template
# Copy to compose/.env on media-vm and fill in real values.
# NEVER commit real values to git.

# Public HTTPS URL — must match exactly what you enter in Claude connector settings
SPOTBOOK_PUBLIC_BASE_URL=https://spotbook.xransum.com

# Google Maps API key — restricted to Places API (New) + Routes API in Cloud Console
GOOGLE_MAPS_API_KEY=<get from Google Cloud Console → Credentials>

# GitHub OAuth App credentials
# App settings: github.com/settings/developers → OAuth Apps → spotbook
SPOTBOOK_GITHUB_CLIENT_ID=<get from GitHub OAuth App settings>
SPOTBOOK_GITHUB_CLIENT_SECRET=<get from GitHub OAuth App settings>

# Your numeric GitHub user ID (not username — IDs are stable, usernames can change)
# Find it: curl https://api.github.com/users/<your-login> | grep '"id"'
SPOTBOOK_GITHUB_ALLOWED_USER_ID=<your numeric GitHub user ID>

# SQLite database path — must be on a LOCAL volume, not NFS
SPOTBOOK_DB_PATH=/data/spotbook.db

# Backup directory — local by default; see docs/spotbook.md for NAS setup
SPOTBOOK_BACKUP_DIR=/data/backups

# Monthly Google API caps (free tier: Enterprise 1000, Pro 5000)
# Set conservatively below the free tier to avoid unexpected charges
SPOTBOOK_ENTERPRISE_MONTHLY_CAP=900
SPOTBOOK_PRO_MONTHLY_CAP=4500

# Optional: Discord webhook for operational alerts (cap warnings, backup failures)
# Leave empty to disable. Use a dedicated webhook — do NOT reuse the scan-media webhook.
SPOTBOOK_DISCORD_WEBHOOK=
