# torbox-blocklist example env -- copy to compose/torbox-blocklist.env on media-vm
# NEVER commit the real env file (it contains API keys).

# TorBox API key -- get from TorBox account settings
TORBOX_API_KEY=get_from_torbox_account_settings

# Sonarr connection
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=get_from_sonarr_settings_general

# Radarr connection
RADARR_URL=http://radarr:7878
RADARR_API_KEY=get_from_radarr_settings_general

# Minutes a torrent must be in stalled/error state before action is taken
STUCK_MINUTES=5

# Minutes after completion before a TorBox cloud task is eligible for cleanup
# (gives *arr time to import before we delete the cloud task)
COMPLETED_CLEANUP_MINUTES=60

# Set to false once you have verified the script behaves correctly in dry-run
DRY_RUN=true

# Polling interval in seconds (TorBox rate limit: 60 req/hr -- keep >= 120)
POLL_INTERVAL_SECONDS=120

# Block downloading torrents that have 0 seeders after STUCK_MINUTES.
# With 0 seeders there is no data source and progress is impossible regardless
# of peer count. Set to false to disable this check.
ZERO_SEED_CHECK=true
