# byparr-proxy Docker environment file.
# Used by compose/docker-compose.yml for each byparr-proxy instance.
# Copy and rename per instance (e.g. byparr-proxy-1337x.env, byparr-proxy-apibay.env).
# Mirrors scripts/byparr-proxy.env.example — keep in sync.

# Upstream indexer base URL. No trailing slash.
UPSTREAM=https://1337x.to

# Byparr /v1 endpoint.
# For HTML indexers (1337x, YTS, etc.): point at Byparr directly.
# For JSON/RSS indexers (apibay, etc.): point at byparr-unwrap sidecar.
BYPARR=http://byparr:8191/v1

# Per-request timeout passed to Byparr (ms).
TIMEOUT_MS=120000

# Local listen port inside the container. The compose file maps this to
# a host port. Pick a unique port per instance.
#   8881 -> 1337x
#   8882 -> apibay
PORT=8881

LOG_LEVEL=INFO

# In-memory cache TTL for successful responses (seconds). 0 to disable.
CACHE_TTL_S=3600

# Short-circuit /cat/... health-test paths with a synthetic results page.
STUB_CAT_PATHS=true
