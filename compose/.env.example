# server-stack Docker Compose environment variables
# Copy to .env in the compose/ directory and fill in secrets.
# Lines starting with # are comments. Never commit .env to git.

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=America/New_York

# ---------------------------------------------------------------------------
# Plex
# ---------------------------------------------------------------------------
# One-time claim token from https://www.plex.tv/claim (expires in 4 min).
# Only needed on first run to link the server to your Plex account.
# Leave blank after first run.
PLEX_CLAIM=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (proxy profile)
# ---------------------------------------------------------------------------
# Create a tunnel at https://one.dash.cloudflare.com → Zero Trust → Tunnels.
# Copy the token here.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# queue-cleaner
# ---------------------------------------------------------------------------
# Path to env file containing Sonarr/Radarr API keys.
# Default: ./queue-cleaner.env (create from docker/queue-cleaner/example.env)
QUEUE_CLEANER_ENV=./queue-cleaner.env

# ---------------------------------------------------------------------------
# dns-updater (deprecated — use CF Tunnel instead)
# ---------------------------------------------------------------------------
DNS_UPDATER_ENV=./dns-updater.env

# ---------------------------------------------------------------------------
# Game servers (docker-compose.gameservers.yml)
# ---------------------------------------------------------------------------

# Valheim
VALHEIM_WORLD_NAME=Dedicated
VALHEIM_SERVER_PASS=changeme

# Palworld
PALWORLD_SERVER_PASSWORD=

# CS2
# Get token from https://steamcommunity.com/dev/managegameservers
CS2_SRCDS_TOKEN=

# Pterodactyl Panel
PTERODACTYL_DB_PASSWORD=changeme
PTERODACTYL_HASHIDS_SALT=changeme
