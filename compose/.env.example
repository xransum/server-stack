# server-stack Docker Compose environment variables
# Copy to .env in the compose/ directory and fill in secrets.
# Lines starting with # are comments. Never commit .env to git.

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
TZ=America/New_York

# ---------------------------------------------------------------------------
# Plex
# ---------------------------------------------------------------------------
# One-time claim token from https://www.plex.tv/claim (expires in 4 min).
# Only needed on first run to link the server to your Plex account.
# Leave blank after first run.
PLEX_CLAIM=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (edge-vm only — docker-compose.edge.yml)
# ---------------------------------------------------------------------------
# Create a tunnel at https://one.dash.cloudflare.com → Zero Trust → Tunnels.
# Copy the token here. Used by edge-vm, not media-vm.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare DDNS (edge-vm only — docker-compose.edge.yml)
# ---------------------------------------------------------------------------
# Scoped API token with Zone:DNS:Edit on xransum.com.
# Keeps grey-cloud records (plex, game servers) updated when home IP changes.
# Create at: dash.cloudflare.com → My Profile → API Tokens
# Used by edge-vm, not media-vm.
CF_DDNS_TOKEN=

# ---------------------------------------------------------------------------
# Shared API keys (used by rdt-blocklist, scan-media, and other services)
# ---------------------------------------------------------------------------
# Rotate here and update compose/rdt-blocklist.env and compose/scan-media.env.
RADARR_API_KEY=
SONARR_API_KEY=

# Discord webhook for scan-media infection/error notifications.
# Create at: Discord server → Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# queue-cleaner
# ---------------------------------------------------------------------------
# Path to env file containing Sonarr/Radarr API keys.
# Default: ./queue-cleaner.env (create from docker/queue-cleaner/example.env)
QUEUE_CLEANER_ENV=./queue-cleaner.env

# ---------------------------------------------------------------------------
# rdt-blocklist
# ---------------------------------------------------------------------------
# Path to env file containing RDT DB path and Sonarr/Radarr API keys.
# Default: ./rdt-blocklist.env (create from docker/rdt-blocklist/example.env)
RDT_BLOCKLIST_ENV=./rdt-blocklist.env

# ---------------------------------------------------------------------------
# dns-updater (deprecated — use CF Tunnel instead)
# ---------------------------------------------------------------------------
DNS_UPDATER_ENV=./dns-updater.env

# ---------------------------------------------------------------------------
# Game servers (docker-compose.gameservers.yml -- Pelican)
# ---------------------------------------------------------------------------
# Per-game settings (world names, passwords, tokens) are configured per-server
# inside the Pelican Panel UI from each egg -- they are NOT set here. This stack
# only needs the Panel's own secrets below.

# Pelican Panel
PELICAN_APP_URL=https://pelican.xransum.com
PELICAN_DB_PASSWORD=
